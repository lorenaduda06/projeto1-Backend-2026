<h2>Lista de Habilidades</h2>
<br>
<table border="1" width="60%">
    <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Ações</th>
    </tr>

    {{#each habilidades}}
    <tr>
        <td>{{id}}</td>
        <td>{{nome}}</td>
        <td>
            <a href="/habilidadeUpdate/{{id}}">Editar</a> |
            <a href="/habilidadeDelete/{{id}}" onclick="return confirm('Tem certeza?')">Excluir</a>
        </td>
    </tr>
    {{/each}}
</table>
<br>
<a href="/habilidadeCreate"><button>Nova Habilidade</button></a>