<h2 class="page-title">Lista de Habilidades</h2>
<br>
<table class="data-table habilidades-list-table" border="1" width="60%">
    <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Ações</th>
    </tr>

    {{#each habilidades}}
    <tr>
        <td>{{id}}</td>
        <td>{{nome}}</td>
        <td>
            <a class="table-action edit-action" href="/habilidadeUpdate/{{id}}">Editar</a> |
            <a class="table-action delete-action" href="/habilidadeDelete/{{id}}"
                onclick="return confirm('Tem certeza?')">Excluir</a>
        </td>
    </tr>
    {{/each}}
</table>
<br>
<a class="create-link" href="/habilidadeCreate"><button class="btn-submit">Nova Habilidade</button></a>