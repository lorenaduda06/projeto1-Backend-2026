<h2>Editar Habilidade</h2>
<br>

<form action="/habilidadeUpdate" method="post">
    <input type="hidden" name="id" value={{habilidade.id}}>
    Nome: <input type="text" name="nome" value="{{habilidade.nome}}">
    <br><br>
    <input type="submit" value="Atualizar">
</form>

<br>
<a href="/habilidadeDelete/{{habilidade.id}}">
    <button>Excluir</button>
</a>