<h2 class="page-title">Editar Habilidade</h2>
<br>

<form class="form-centralizado form-editar" action="/habilidadeUpdate" method="post">
    <input type="hidden" name="id" value={{habilidade.id}}>
    Nome: <input class="form-input" type="text" name="nome" value="{{habilidade.nome}}">
    <br><br>
    <input class="btn-submit" type="submit" value="Atualizar">
</form>

<br>
<a class="delete-link" href="/habilidadeDelete/{{habilidade.id}}">
    <button class="btn-danger">Excluir</button>
</a>