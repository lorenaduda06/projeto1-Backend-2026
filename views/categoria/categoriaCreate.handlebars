<h2>Cadastrar Nova Categoria</h2>
<br>
<form action="/categoriaCreate" method="post">
    <table border="0">
        <tr>
            <td>Nome da Categoria:</td>
            <td><input type="text" name="nome" size="40" required></td>
        </tr>

        <tr>
            <td colspan="2" align="center">
                <input type="submit" value="Cadastrar">
            </td>
        </tr>
    </table>
</form>