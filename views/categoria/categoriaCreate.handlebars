<h2 class="page-title">Cadastrar Nova Categoria</h2>
<br>
<form class="form-centralizado" action="/categoriaCreate" method="post">
    <table class="form-table" border="0">
        <tr>
            <td>Nome da Categoria:</td>
            <td><input class="form-input" type="text" name="nome" size="40" required></td>
        </tr>

        <tr>
            <td colspan="2" align="center">
                <input class="btn-submit" type="submit" value="Cadastrar">
            </td>
        </tr>
    </table>
</form>