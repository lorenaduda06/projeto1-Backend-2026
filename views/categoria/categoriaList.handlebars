<h2>Lista de Categorias</h2>
<br>

<table border="1" width="60%">
    <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Ações</th>
    </tr>

    {{#each categorias}}
    <tr>
        <td>{{id}}</td>
        <td>{{nome}}</td>
        <td>
            <a href="/categoriaUpdate/{{id}}">Editar</a> |
            <a href="/categoriaDelete/{{id}}" onclick="return confirm('Tem certeza?')">Excluir</a>
        </td>
    </tr>
    {{/each}}
</table>
<br>
<a href="/categoriaCreate"><button>Nova Categoria</button></a>