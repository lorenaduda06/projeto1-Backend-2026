<h2 class="page-title">Editar Categoria</h2>
<br>

<form class="form-centralizado form-editar" action="/categoriaUpdate" method="post">
    <input type="hidden" name="id" value={{categoria.id}}>
    Nome: <input class="form-input" type="text" name="nome" value="{{categoria.nome}}">
    <br><br>
    <input class="btn-submit" type="submit" value="Atualizar">
</form>

<br>
<a class="delete-link" href="/categoriaDelete/{{categoria.id}}">
    <button class="btn-danger">Excluir</button>
</a>