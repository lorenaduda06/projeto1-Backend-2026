<h2 class="page-title">Lista de Alunos</h2>
<br>
<table class="data-table alunos-table" border="1" width="80%">
    <tr>
        <th>ID</th>
        <th>Email</th>
        <th>Tipo</th>

        {{#if admin}}
        <th>Ações</th>
        {{/if}}
    </tr>

    {{#each alunos}}
    <tr>
        <td>{{id}}</td>
        <td>{{email}}</td>
        <td>
            <span class="tipo-badge {{#if tipo}}tipo-admin{{else}}tipo-aluno{{/if}}">
                {{#if tipo}}Admin{{else}}Aluno{{/if}}
            </span>
        </td>

        {{#if ../admin}}
        <td>
            <a class="table-action edit-action" href="/alunoUpdate/{{id}}">Editar</a> |
            <a class="table-action delete-action" href="/alunoDelete/{{id}}"
                onclick="return confirm('Tem certeza?')">Excluir</a>
        </td>
        {{/if}}
    </tr>
    {{/each}}
</table>