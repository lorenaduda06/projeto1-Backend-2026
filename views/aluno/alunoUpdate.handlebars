<h2 class="page-title">Editar Aluno</h2>
<br>

<form class="form-centralizado" action="/alunoUpdate" method="post">
    <input type="hidden" name="id" value={{aluno.id}}>
    Nome: <input class="form-input" type="text" name="nome" value="{{aluno.nome}}">
    <br><br>

    Email: <input class="form-input" type="text" name="email" value="{{aluno.email}}">
    <br><br>

    Senha: <input class="form-input" type="password" name="senha" value="{{aluno.senha}}">
    <br><br>

    Tipo:
    <select class="form-select" name="tipo">
        <option value="0">Aluno</option>
        <option value="1">Administrador</option>
    </select>
    <br><br>
    <input class="btn-submit" type="submit" value="Atualizar">
</form>

<br>
<a class="delete-link" href="/alunoDelete/{{aluno.id}}">
    <button class="btn-danger">Excluir</button>
</a>