<h2>Editar Aluno</h2>
<br>

<form action="/alunoUpdate" method="post">
    <input type="hidden" name="id" value={{aluno.id}}>
    Nome: <input type="text" name="nome" value="{{aluno.nome}}">
    <br><br>

    Email: <input type="text" name="email" value="{{aluno.email}}">
    <br><br>

    Senha: <input type="password" name="senha" value="{{aluno.senha}}">
    <br><br>

    Tipo:
    <select name="tipo">
        <option value="0">Aluno</option>
        <option value="1">Administrador</option>
    </select>
    <br><br>
    <input type="submit" value="Atualizar">
</form>

<br>
<a href="/alunoDelete/{{aluno.id}}">
    <button>Excluir</button>
</a>