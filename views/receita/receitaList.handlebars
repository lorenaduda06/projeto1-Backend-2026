<h2 class="page-title">Minhas Receitas</h2>
<br>

{{#if receitas}}
<div class="receitas-lista">
    {{#each receitas}}
    <table class="receita-table minhas-receitas-table" border="1" width="80%">
        <tr>
            <th width="30%">Nome:</th>
            <td>{{nome}}</td>
        </tr>

        <tr>
            <th>Imagem</th>
            <td>
                {{#if imagem}}
                <img class="receita-img" src="/uploads/{{imagem}}" width="100" alt="{{nome}}">

                {{else}}
                <span class="muted-text">Nenhuma imagem foi enviada</span>
                {{/if}}
            </td>
        </tr>

        <tr>
            <th>Descrição:</th>
            <td>{{descricao}}</td>
        </tr>

        <tr>
            <th>Link Externo:</th>
            <td><a class="receita-link" href="{{link_externo}}" target="_blank">{{link_externo}}</a></td>
        </tr>

        <tr>
            <th>Categorias:</th>
            <td>
                {{#each Categorias}}
                <span class="tag">{{nome}}</span>
                {{/each}}
            </td>
        </tr>

        <tr>
            <th>Responsáveis:</th>
            <td>
                {{#each Alunos}}
                <span class="responsavel">{{nome}}</span>
                {{/each}}
            </td>
        </tr>

        <tr>
            <td colspan="2" align="center">
                <a href="/receitaUpdate/{{id}}"><button class="btn-small">Editar</button></a>
                <a href="/receitaDelete/{{id}}" onclick="return confirm('Tem certeza?')"><button
                        class="btn-small btn-remove">Excluir</button></a>
            </td>
        </tr>

        <tr>
            <td colspan="2" align="center">
                <a href="/comentarioList/{{id}}"><button class="btn-small">Ver Comentários</button></a>
                <a href="/comentarioCreate/{{id}}"><button class="btn-small btn-secondary">Comentar</button></a>
            </td>
        </tr>
    </table>
    <br><br>
    {{/each}}
</div>
{{else}}
<p class="empty-message">Você ainda não tem receitas cadastradas.</p>
<br>
<a class="create-link" href="/receitaCreate"><button>Cadastrar Primeira Receita</button></a>
{{/if}}