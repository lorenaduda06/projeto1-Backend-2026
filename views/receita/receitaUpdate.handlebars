<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Receita</title>
</head>
<body>
    <h2>Editar Receita</h2>
    <br>

    <form action="/receitaUpdate" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value={{receita.id}}>
        Nome: <input type="text" name="nome" value="{{receita.nome}}">
        <br><br>
    
        Descrição: <textarea name="descricao" rows="4" cols="50">{{receita.descricao}}</textarea>
        <br><br>
    
        Link Externo: <input type="text" name="link_externo" value="{{receita.link_externo}}">
        <br><br>
    
        Imagem: <input type="file" name="imagem" accept="image/*">
        <br><br>

        <b>Categorias:</b><br>
        {{#each categorias}}
            <input type="checkbox" name="categoria_ids" value="{{id}}"> {{nome}}<br>
        {{/each}}

        <br>
        <b>Alunos responsáveis:</b><br>
        {{#each alunos}}
            <input type="checkbox" name="aluno_ids" value="{{id}}"> {{nome}}<br>
        {{/each}}

        <br>
        <input type="submit" value="Atualizar Receita">
    </form>

    <br>
    <a href="/receitaDelete/{{receita.id}}">
        <button>Excluir</button>
    </a>
</body>
</html>