<h2>Cadastrar Comentário</h2>
<br>

<form action="/comentarioCreate" method="post">
    <table border="0">
        <input type="hidden" name="receita_id" value="{{receita_id}}">

        <tr>
            <td>Título:</td>
            <td><input type="text" name="titulo" size="50" required></td>
        </tr>

        <tr>
            <td>Texto:</td>
            <td><textarea name="texto" rows="5" cols="50" required></textarea></td>
        </tr>

        <tr>
            <td colspan="2" align="center">
                <input type="submit" value="Cadastrar Comentário">
            </td>
        </tr>
    </table>
</form>

<br>
<a href="/receitaList">Voltar para minhas receitas</a>