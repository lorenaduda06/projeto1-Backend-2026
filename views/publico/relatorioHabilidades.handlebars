<h2 class="page-title">Relatório: Proporção de Alunos por Habilidade</h2>
<br>

{{#if relatorio}}
<div class="relatorio-wrapper"></div>
<table class="relatorio-table">
    <tr>
        <th>Habilidade</th>
        <th>Qtd Alunos</th>
        <th>Proporção (%)</th>
    </tr>

    {{#each relatorio}}
    <tr>
        <td>{{nome}}</td>
        <td>{{qt}}</td>
        <td>
            <span class="percentual">{{distribuicao_por_hab}}%</span>
        </td>
    </tr>
    {{/each}}
</table>
<br>
<p class="relatorio-info">Proporção calculada com base no total de alunos cadastrados.</p>
</div>
{{else}}
<p class="empty-message">Nenhuma habilidade cadastrada ainda.</p>
{{/if}}