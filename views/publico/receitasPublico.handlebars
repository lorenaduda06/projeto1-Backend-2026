<h2 class="page-title">Todas as Receitas Cadastradas</h2>
<br>
<div class="receitas-lista"></div>
{{#if receitas}}
{{#each receitas}}
<table class="receita-table">
    <tr>
        <th>Nome:</th>
        <td>{{nome}}</td>
    </tr>

    <tr>
        <th>Descrição:</th>
        <td>{{descricao}}</td>
    </tr>

    <tr>
        <th>Link Externo:</th>
        <td><a class="receita-link" href="{{link_externo}}" target="_blank">{{link_externo}}</a></td>
    </tr>

    <tr>
        <th>Categorias:</th>
        <td>
            {{#each Categorias}}
            <span class="tag">{{nome}}</span>
            <br>
            {{/each}}
        </td>
    </tr>

    <tr>
        <th>Responsáveis:</th>
        <td>
            {{#each Alunos}}
            <span class="responsavel">{{nome}}</span>
            <br>
            {{/each}}
        </td>
    </tr>

    <tr>
        <td colspan="2" align="center">
            <a href="/comentarioList/{{id}}"><button class="btn-comentarios">Ver Comentários</button></a>
        </td>
    </tr>
</table>
<br><br>
{{/each}}
{{else}}
<p class="empty-message">Nenhuma receita cadastrada ainda.</p>
{{/if}}
<div class="login-link">
    <a href="/login">Login</a>
</div>