<h2>Receitas por Categoria</h2>
<br>

<h3>Escolha uma categoria:</h3>
{{#each categorias}}
<a href="/public/categoria/{{id}}">{{nome}}</a><br>
{{/each}}

<br>
<hr><br>

{{#if receitas}}
<h3>Receitas encontradas:</h3>
<br>
{{#each receitas}}
<table border="1" width="80%">
    <tr>
        <th width="30%">Nome:</th>
        <td>{{nome}}</td>
    </tr>
    <tr>
        <th>Descrição:</th>
        <td>{{descricao}}</td>
    </tr>
    <tr>
        <th>Link Externo:</th>
        <td><a href="{{link_externo}}" target="_blank">{{link_externo}}</a></td>
    </tr>
    <tr>
        <th>Categorias:</th>
        <td>
            {{#each Categorias}}{{nome}}<br>{{/each}}
        </td>
    </tr>
    <tr>
        <th>Responsáveis:</th>
        <td>
            {{#each Alunos}}{{nome}}<br>{{/each}}
        </td>
    </tr>
    <tr>
        <td colspan="2" align="center">
            <a href="/comentarioList/{{id}}"><button>Ver Comentários</button></a>
        </td>
    </tr>
</table>
<br><br>
{{/each}}
{{/if}}

<br>
<a href="/">Voltar para todas as receitas</a>